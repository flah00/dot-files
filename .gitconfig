[user]
	name = Philip Champon
	email = philip.champon@droitfintech.com
	signingkey = 7DAF9BF13076C43F
[difftool]
	#prompt = true
[diff]
	tool = nvimdiff
[core]
	editor = nvim
	excludesfile = /home/philip.champon/.gitignore_global
	autocrlf = false
[merge]
	tool = nvimdiff
[color]
	status = auto
	branch = auto
	interactive = auto
	diff = auto
	show-branch = auto
[alias]
	co = checkout
	up = pull
	unstage = reset HEAD --
	last = log -1 HEAD
	diff-staged = diff --cached
	short-log = log --abbrev=8 --oneline
	gone = ! git fetch -p && git for-each-ref --format '%(refname:short) %(upstream:track)' | awk '$2 == \"[gone]\" {print $1}' | xargs -r git branch -D
[github]
	user = flah00
[merge "nvimdiff"]
[push]
	default = current
[secrets]
	yml = /tmp/test
[init]
	defaultBranch = main
[pull]
	rebase = false
[safe]
	directory = /work
[commit]
	gpgsign = true
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
