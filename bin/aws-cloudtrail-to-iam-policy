#!/usr/bin/env -S python -u
# aws cloudtrail lookup-events --lookup-attributes AttributeKey=Username,AttributeValue=$USERNAME | aws-cloudtrail-to-iam-policy -a 123
# Generate an AWS IAM policy using cloudtrail event json logs (as generated by AWS UI or AWS CLI)
# Cloudtrail events
# https://docs.aws.amazon.com/awscloudtrail/latest/userguide/cloudtrail-events.html
#
# NOTE: if you encounter an error, eg DO NOT KNOW ABOUT
#       review the cloudtrail event and the referenced function
#       and add the service to the appropriate `case`
#
# pull events from a json log in a file or stdin
# drop them into a dictionary of dictionaries
#   inner dict keys are AWS_SERVICE or AWS_SERVICE-res
#   -res keys have a resource associated with the action
# dict[AWS_ACCT_ID]
#   dict[AWS_SERVICE] resource-less requests eg ec2, s3, cognito-idp, etc
#     Action: set(AWS_SERVICE:ACTION, ...)
#     Resource: set(ARN, ...)
#   dict[AWS_SERVICE-res] accesses specific resource eg ec2, s3, cognito-idp, etc
#     Action: set(AWS_SERVICE:ACTION, ...)
#     Resource: set(ARN, ...)
# convert that into a policy
# print the results to a file or stdout
#
import argparse
import json
import sys
from pprint import pprint

STATEMENTS = {}
DEFAULT_IGNORES = [
    "health",
    "servicecatalog-appregistry",
    "ce",
    "cost-optimization-hub",
    "cloudtrail",
]


def err(str, obj=None):
    sys.stderr.write(str)
    if obj:
        pprint(obj)
    sys.exit(1)


def parseargs():
    parser = argparse.ArgumentParser(
        description="convert cloud trail json logs to iam policy"
    )
    parser.add_argument(
        "-a",
        "--account-id",
        required=False,
        metavar="ACCT_ID",
        help="The primary AWS account id",
    )
    parser.add_argument(
        "-i",
        "--input",
        default="-",
        metavar="FILE",
        help="JSON input file, defaults to STDIN",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="-",
        metavar="FILE",
        help="JSON output file, defaults to STDOUT",
    )
    parser.add_argument(
        "-I",
        "--ignore",
        default=[],
        metavar="AWS_SVC",
        help="Ignore AWS services, eg cloudtrail, ec2, etc",
        action="append",
    )
    args = parser.parse_args()
    if args.input == "-":
        args.input_ref = sys.stdin
    else:
        args.input_ref = open(args.input, mode="r", encoding="utf-8")
    if args.output == "-":
        args.output_ref = sys.stdout
    else:
        args.output_ref = open(args.output, mode="w", encoding="utf-8")
    args.ignore += DEFAULT_IGNORES
    return args


# keep resource specific events separate from events that lack resources
# so we can generate policies correctly
def statement_add(acct_id, svc, evname, resource=None):
    if not acct_id or not svc or not evname:
        err(
            f"ERROR statement_add missing data acct_id:'{acct_id}' svc:'{svc}' evname:'{evname}'"
        )

    if resource:
        svc_key = svc + "-res"
    else:
        svc_key = svc

    if acct_id not in STATEMENTS:
        STATEMENTS[acct_id] = {}
    if svc_key not in STATEMENTS[acct_id]:
        STATEMENTS[acct_id][svc_key] = {"Action": set(), "Resource": set()}
    STATEMENTS[acct_id][svc_key]["Action"].add(svc + ":" + evname)
    if resource:
        STATEMENTS[acct_id][svc_key]["Resource"].add(resource)


# assume sts is related to assuming roles etc?
# try to constraint requests to specific resources
# secretsmanager is odd one out, doesn't rely on ARN and accountId
def parse_params_and_resources(rec, svc):
    match svc:
        case "secretsmanager":
            statement_add(
                rec["recipientAccountId"],
                svc,
                rec["eventName"],
                rec["requestParameters"].get("secretId"),
            )
        case "s3" | "dynamodb" | "ssm" | "logs" | "kms" | "ecr":
            for res in rec["resources"]:
                statement_add(res["accountId"], svc, rec["eventName"], res["ARN"])
        case "sts":
            pass
        case _:
            err(
                f"ERROR DO NOT KNOW ABOUT parse_params_and_resources() svc {svc}\n", rec
            )


# notifcations doesn't seem important?
# try to limit secretsmanager to specific resources
# assume the remaining svc are reads?
def parse_params(rec, svc):
    match svc:
        case "ssm":
            # requestParameters: {parameterFilters: [{key:Name, option:Equals, values:[/tf/infra/path]}]}
            filters = rec["requestParameters"].get("parameterFilters")
            if filters:
                # find the name equals condition
                cond = [
                    x["values"][0]
                    for x in filters
                    if x["key"] == "Name" and x["option"] == "Equals"
                ]
                # extract region and account_id
                region = rec["awsRegion"]
                account_id = rec["recipientAccountId"]
                cond_name = f"arn:aws:ssm:{region}:{account_id}:parameter{cond[0]}"
            else:
                cond_name = None
            statement_add(rec["recipientAccountId"], svc, rec["eventName"], cond_name)
        case "secretsmanager":
            statement_add(
                rec["recipientAccountId"],
                svc,
                rec["eventName"],
                rec["requestParameters"].get("secretId"),
            )
        case "cloudfront":
            statement_add(
                rec["recipientAccountId"],
                svc,
                rec["eventName"],
                rec["requestParameters"].get("resource"),
            )
        case "route53domains":
            statement_add(rec["recipientAccountId"], svc, rec["eventName"])
        case (
            "iam"
            | "acm"
            | "apigateway"
            | "cognito-idp"
            | "ec2"
            | "eks"
            | "elasticache"
            | "elasticloadbalancing"
            | "events"
            | "fis"
            | "lambda"
            | "logs"
            | "rds"
            | "route53"
            | "s3"
            | "wafv2"
        ):
            statement_add(rec["recipientAccountId"], svc, rec["eventName"])
        case "notifications":
            pass
        case _:
            err(f"ERROR DO NOT KNOW ABOUT parse_params() svc {svc}\n", rec)


# didn't find any resource only events, will that always be true? this will tell us
def parse_resources(rec, svc):
    match svc:
        case _:
            err(f"ERROR DO NOT KNOW ABOUT parse_resources() svc {svc}\n", rec)


def parse_json(input):
    # UI JSON dump
    if "Records" in input:
        parse = input["Records"]
    # AWS CLI cloudtrail lookup-events JSON output
    elif "Events" in input:
        parse = map(lambda e: json.loads(e["CloudTrailEvent"]), input["Events"])
    else:
        err(f"No known key found in {args.input}")

    for rec in parse:
        # iam.amazonaws.com > iam
        svc = rec["eventSource"].split(".")[0]
        if svc in args.ignore:
            sys.stderr.write(f"Ignoring {svc}:{rec['eventName']}\n")
            continue

        if (
            "requestParameters" in rec
            and rec["requestParameters"]
            and "resources" in rec
            and rec["resources"]
        ):
            parse_params_and_resources(rec, svc)
        elif "resources" in rec and rec["resources"]:
            parse_resources(rec, svc)
        elif "requestParameters" in rec and rec["requestParameters"]:
            parse_params(rec, svc)
        else:
            pass


def create_policy():
    json_policy = {"Version": "2012-10-17", "Statement": []}
    # STATEMENTS key is acct_id, resurrect for AWS principal support
    for _, data in STATEMENTS.items():
        for _, sets in data.items():
            policy = {
                "Effect": "Allow",
                "Action": sorted(sets["Action"]),
                "Resource": sorted(sets["Resource"]),
            }
            json_policy["Statement"] += [policy]

    return json_policy


if __name__ == "__main__":
    args = parseargs()
    json_input = json.load(args.input_ref)
    parse_json(json_input)
    json_policy = create_policy()
    args.output_ref.write(json.dumps(json_policy, sort_keys=True, indent=2))
    args.output_ref.close()
